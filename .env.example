# Copy this file to .env and fill in your keys. Never commit .env.

# Development: 1 gives auto-reload and the debugger when you use run.py.
# Never use 1 on a server other people can reach.
FLASK_DEBUG=1

# TheMealDB: the public test key "1" works for development.
THEMEALDB_API_KEY=1

# Spoonacular: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY

# Open Food Facts needs no key, but asks every app to send a User-Agent with
# the app name, version and a contact (an email address or your repo URL).
OPENFOODFACTS_USER_AGENT=MealPlanner/1.0 (your-email@example.com)

# Publishing through a Cloudflare Tunnel (see the README):
# A password for the whole site; any username works. Use a long one.
# Leave it empty for local-only use.
APP_PASSWORD=
# Set to 1 when the app runs behind a Cloudflare Tunnel.
BEHIND_PROXY=0
# Optional: keep the database somewhere else, for example outside OneDrive.
# DATABASE_PATH=C:/meal-planner-data/meal_planner.db

SECRET_KEY=change-me